# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...your_token_here

# Чат класса: числовой id (для групп отрицательный, напр. -1001234567890) или @имя_чата
CHAT_ID=-1001234567890

# Для-форума: id ветки (topic), куда слать посты. Лучше не задавать здесь,
# а написать боту /тема внутри нужной ветки — он запомнит сам.
# THREAD_ID=777

# Класс, за которым следит бот (как на сайте: 10Н, 11А, 9Б…)
CLASS=10Н

# Часовой пояс
TZ=Asia/Yekaterinburg

# Как часто проверять расписание (минуты)
POLL_MINUTES=10

# Во сколько постить расписание на завтра (вс–пт)
DAILY_HOUR=15

# Telegram id администратора (для /проверить и /статус)
ADMIN_ID=123456789

# --- необязательные ---
# Путь к SQLite
DB_PATH=data/bot.db
# Горизонт опроса в днях (минимум 7, чтобы покрыть Пн–Сб)
HORIZON_DAYS=7
# Уровень логирования
LOG_LEVEL=INFO

# Вход в электронный журнал lycreg.urfu.ru (для ДЗ; пусто — ДЗ не подключается)
# LYCREG_LOGIN=
# LYCREG_PASSWORD=
